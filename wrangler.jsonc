{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "towards-eden-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "towardseden.com", "custom_domain": true },
    { "pattern": "www.towardseden.com", "custom_domain": true }
  ],
  // Keep the *.workers.dev URL and preview URLs alive alongside the custom
  // domains (adding routes would otherwise disable them by default).
  "workers_dev": true,
  "preview_urls": true,
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "towards-eden-app"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
